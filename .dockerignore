# Keep the build context small — src/, the one model file, and the one feature
# table the dashboard serves metrics from.
.git/
data/
notebooks/
# reports/ is excluded except the single CSV the dashboard needs (re-included below)
reports/*
!reports/phase6_voxintel_r_slurp
reports/phase6_voxintel_r_slurp/*
!reports/phase6_voxintel_r_slurp/voxintel_r_features.csv
experiments/
artifacts/
configs/
tests/
.github/
**/__pycache__/
*.pyc
*.ipynb
README.md
requirements.txt
# don't ship the whole models/ dir; the Dockerfile COPYs the one joblib it needs
models/*
!models/voxintel_r_intent_rf.joblib
